# Скопируйте в inventory/secrets.yml, замените оба пароля и зашифруйте:
#   ansible-vault encrypt inventory/secrets.yml
# Незашифрованный secrets.yml playbook не читает. В git он не попадает.
# Минимум 8 символов, пароли разные. Это пароль Directory Manager и admin IPA.
freeipa_ds_password: "change-me-dm"
freeipa_admin_password: "change-me-admin"
